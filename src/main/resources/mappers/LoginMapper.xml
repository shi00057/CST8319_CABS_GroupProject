<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.cabs.repository.LoginMapper">

    <resultMap id="SaltMap" type="com.example.cabs.dto.SaltDto">
        <result property="salt" column="Salt" jdbcType="BLOB"/>
    </resultMap>

    <select id="getUserSaltByEmail" parameterType="map" resultMap="SaltMap">
        CALL DABS_sp_GetUserSaltByEmail(#{p_Email,jdbcType=VARCHAR})
    </select>

    <select id="login" parameterType="map" resultType="com.example.cabs.dto.LoginResult">
        CALL DABS_sp_Login(
            #{p_Email,jdbcType=VARCHAR},
            #{p_PasswordHash,jdbcType=BLOB}
            )
    </select>
</mapper>
