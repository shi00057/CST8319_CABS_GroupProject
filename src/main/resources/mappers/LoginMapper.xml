<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.cabs.repository.LoginMapper">
    <select id="getUserSaltByEmail" resultType="string" statementType="CALLABLE">
        CALL DABS_sp_GetUserSaltByEmail(#{p_Email})
    </select>
    <select id="login" resultType="com.example.cabs.dto.LoginResult" statementType="CALLABLE">
        CALL DABS_sp_Login(#{p_Email})
    </select>
</mapper>
