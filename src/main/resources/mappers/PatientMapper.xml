<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.cabs.repository.PatientMapper">

    <!-- SP: DABS_sp_RegisterPatient(email, passwordHash, salt, fullName, phone)
         returns: SELECT v_UserId AS UserId -->
    <select id="registerPatient"
            statementType="CALLABLE"
            parameterType="map"
            resultType="java.lang.Integer">
        { call DABS_sp_RegisterPatient(
                #{email,        mode=IN, jdbcType=VARCHAR},
                #{passwordHash, mode=IN, jdbcType=VARBINARY},
                #{salt,         mode=IN, jdbcType=VARBINARY},
                #{fullName,     mode=IN, jdbcType=VARCHAR},
                #{phone,        mode=IN, jdbcType=VARCHAR}
               ) }
    </select>

    <!-- SP: DABS_sp_GetPatientById(patientId) -> Patient row -->
    <select id="getPatientById"
            statementType="CALLABLE"
            parameterType="map"
            resultType="com.example.cabs.domain.Patient">
        { call DABS_sp_GetPatientById(
                #{patientId, mode=IN, jdbcType=INTEGER}
               ) }
    </select>

    <!-- SP: DABS_sp_GetPatientIdByUserId(userId) -> Integer -->
    <select id="getPatientIdByUserId"
            statementType="CALLABLE"
            parameterType="map"
            resultType="java.lang.Integer">
        { call DABS_sp_GetPatientIdByUserId(
                #{userId, mode=IN, jdbcType=INTEGER}
               ) }
    </select>

    <!-- SP: DABS_sp_ListPatientsPendingActivation() -> List<PatientActivationDto> -->
    <select id="listPatientsPendingActivation"
            statementType="CALLABLE"
            resultType="com.example.cabs.dto.PatientActivationDto">
        { call DABS_sp_ListPatientsPendingActivation() }
    </select>

    <!-- SP: DABS_sp_ActivateUser(userId, isActive) -->
    <update id="activateUser"
            statementType="CALLABLE"
            parameterType="map">
        { call DABS_sp_ActivateUser(
                #{userId,   mode=IN, jdbcType=INTEGER},
                #{isActive, mode=IN, jdbcType=TINYINT}
               ) }
    </update>

    <!-- SP: DABS_sp_UpdatePatient(patientId, fullName) -->
    <update id="updatePatient"
            statementType="CALLABLE"
            parameterType="map">
        { call DABS_sp_UpdatePatient(
                #{patientId, mode=IN, jdbcType=INTEGER},
                #{fullName,  mode=IN, jdbcType=VARCHAR},
                #{phone,     mode=IN, jdbcType=VARCHAR}
               ) }
    </update>


    <!-- SP: DABS_sp_DeletePatientSoft(patientId) -->
    <update id="deletePatientSoft"
            statementType="CALLABLE"
            parameterType="map">
        { call DABS_sp_DeletePatientSoft(
                #{patientId, mode=IN, jdbcType=INTEGER}
               ) }
    </update>
    <resultMap id="PatientActivationMap" type="com.example.cabs.dto.PatientActivationDto">
        <result property="userId" column="UserId"/>
        <result property="patientId" column="PatientId"/>
        <result property="email" column="Email"/>
        <result property="fullName" column="FullName"/>
        <result property="createdAt" column="CreatedAt"/>
    </resultMap>


</mapper>
