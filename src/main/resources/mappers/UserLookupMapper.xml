<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.cabs.repository.UserLookupMapper">
    <select id="findUserIdByLogin" resultType="int">
        SELECT UserId
        FROM Users
        WHERE Email = #{login}
            LIMIT 1
    </select>
</mapper>
